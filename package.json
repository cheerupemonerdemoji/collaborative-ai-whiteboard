{
	"name": "collaborative-ai-canvas",
	"private": true,
	"version": "0.0.0",
	"packageManager": "pnpm@10.15.1",
	"author": {
		"name": "cheerupemonerdemoji"
	},
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"dev:selfhost": "tsx watch server/index.ts",
		"build": "corepack pnpm run build:selfhost",
		"license:check": "tsx scripts/license-preflight.ts",
		"license:check:production": "tsx scripts/license-preflight.ts --production",
		"license:verify-build": "tsx scripts/license-preflight.ts --verify-build",
		"build:selfhost": "corepack pnpm run license:check:production && vite build --config vite.selfhost.config.ts && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js && corepack pnpm run license:verify-build",
		"build:cloudflare": "corepack pnpm run license:check:production && tsc && vite build",
		"start": "node dist/server/index.js",
		"preview": "vite preview",
		"test": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --noEmit",
		"cf:types": "wrangler types",
		"deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
		"deploy:cloudflare:dry": "npm run build:cloudflare && wrangler deploy --dry-run"
	},
	"dependencies": {
		"@fastify/static": "^10.1.3",
		"@fastify/websocket": "^11.3.0",
		"@tldraw/sync": "^5.4.1",
		"@tldraw/sync-core": "^5.4.1",
		"@tldraw/tlschema": "^5.4.1",
		"@tldraw/utils": "5.4.1",
		"better-sqlite3": "^12.11.1",
		"cloudflare-workers-unfurl": "^0.0.9",
		"fastify": "^5.12.3",
		"itty-router": "^5.0.18",
		"openai": "^7.13.0",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"react-router-dom": "^6.28.2",
		"tldraw": "^5.4.1",
		"ws": "^8.21.3",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.56.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.2",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^6.0.1",
		"concurrently": "^10.0.5",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"wrangler": "^4.135.0"
	}
}
