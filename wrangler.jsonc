{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "collaborative-ai-canvas",
  "main": "worker/worker.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "preview_urls": true,
  "vars": { "OPENAI_MODEL": "gpt-5.6-luna" },
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 0.05 } },
  "assets": { "not_found_handling": "single-page-application", "directory": "./dist/client", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "TLDRAW_DURABLE_OBJECT", "class_name": "TldrawDurableObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TldrawDurableObject"] }],
  "r2_buckets": [{ "binding": "TLDRAW_BUCKET", "bucket_name": "collaborative-ai-canvas-assets" }]
}
