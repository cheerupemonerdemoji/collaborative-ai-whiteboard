# Environment variables.

# --- Self-host server (your-server) ---
# These are read from the process environment (systemd Environment= / EnvironmentFile=),
# not from this file directly. This file documents the supported names.

# Interface and port to bind. Keep 127.0.0.1 and publish only through Tailscale Serve.
HOST=127.0.0.1
PORT=8787

# Persistent application data: room databases (rooms/*.sqlite), board history,
# uploads (assets/), and the central auth.sqlite database. Must live outside the
# Git checkout (see .gitignore).
CANVAS_DATA_DIR=./data

# Compiled SPA served by the self-host server.
CANVAS_CLIENT_DIR=./dist/client

# Central accounts/sessions/boards database. Defaults to $CANVAS_DATA_DIR/auth.sqlite.
CANVAS_AUTH_DB_FILE=./data/auth.sqlite

# JSON file of API token hashes for external AI clients, created by
# scripts/manage-api-tokens.mjs. Keep it outside the data directory and outside Git.
CANVAS_API_TOKENS_FILE=./data/api-tokens.json

# Exact browser origins allowed to mutate state and open WebSockets.
CANVAS_ALLOWED_ORIGINS=https://whiteboard.example.com,http://your-server,http://127.0.0.1:8787,http://localhost:8787

# Keep false after the first administrator account; collaborators join by invitation.
CANVAS_ALLOW_OPEN_REGISTRATION=false

# --- Cloudflare V1 path only ---
# Server-side only. For local Wrangler development copy these to .dev.vars.
# The self-host server does not run an AI model and does not need these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
